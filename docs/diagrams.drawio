        </mxCell>
        <mxCell id="1dijiySgXApiauiCDTFy-18" parent="1dijiySgXApiauiCDTFy-5" style="text;html=1;whiteSpace=wrap;strokeColor=default;fillColor=none;align=center;verticalAlign=middle;rounded=0;dashed=1;container=0;" value="... Possible&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Text&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Here ...&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
