        <mxCell id="1dijiySgXApiauiCDTFy-23" parent="1dijiySgXApiauiCDTFy-5" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeWidth=2;dashed=1;dashPattern=8 8;container=0;" value="" vertex="1">
