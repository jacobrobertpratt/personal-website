        <mxCell id="cmd0ZATRMR-j2Ud92fbf-27" parent="1dijiySgXApiauiCDTFy-4" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;strokeWidth=2;container=0;" value="" vertex="1">
