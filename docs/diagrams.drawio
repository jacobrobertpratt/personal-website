        </mxCell>
        <mxCell id="1dijiySgXApiauiCDTFy-26" parent="1dijiySgXApiauiCDTFy-5" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;dashed=1;dashPattern=8 8;strokeWidth=2;strokeColor=light-dark(#000000,#FF00FF);fontStyle=4;container=0;" value="" vertex="1">
          <mxGeometry height="290" width="330" x="910" y="180" as="geometry" />
        </mxCell>
        <mxCell id="1dijiySgXApiauiCDTFy-27" parent="1dijiySgXApiauiCDTFy-5" style="text;html=1;whiteSpace=wrap;strokeColor=light-dark(#000000,#00FF00);fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=24;dashed=1;strokeWidth=2;container=0;" value="This is an introduction paragraph. My name is Jake I do things and stuff. This site contains a collection of my projects in more detail than can be shown on github. It was also fun to build. Below you&#39;ll see a collection of projects.&amp;nbsp;" vertex="1">
          <mxGeometry height="180" width="670" x="565" y="490" as="geometry" />
        </mxCell>
        <mxCell id="1dijiySgXApiauiCDTFy-28" parent="1dijiySgXApiauiCDTFy-5" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeWidth=2;dashed=1;dashPattern=8 8;container=0;" value="" vertex="1">
          <mxGeometry height="250" width="700" x="550" y="710" as="geometry" />
        </mxCell>
        <mxCell id="1dijiySgXApiauiCDTFy-29" parent="1dijiySgXApiauiCDTFy-5" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeWidth=2;dashed=1;dashPattern=8 8;container=0;" value="" vertex="1">
          <mxGeometry height="250" width="700" x="550" y="960" as="geometry" />
        </mxCell>
        <mxCell id="1dijiySgXApiauiCDTFy-30" parent="1dijiySgXApiauiCDTFy-5" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeWidth=2;dashed=1;dashPattern=8 8;container=0;" value="" vertex="1">
          <mxGeometry height="250" width="700" x="550" y="1300" as="geometry" />
        </mxCell>
        <mxCell id="1dijiySgXApiauiCDTFy-31" parent="1dijiySgXApiauiCDTFy-5" style="text;html=1;whiteSpace=wrap;strokeColor=default;fillColor=default;align=left;verticalAlign=top;rounded=0;spacingLeft=6;dashed=1;container=0;" value="&lt;b&gt;&lt;u&gt;Section&lt;/u&gt;:&lt;/b&gt;&amp;nbsp; Projects&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;The Projects section holds a set of stacked Card objects representing a collection of projects. Each Card is a link to a new page relating to that specific Card. Cards will contain the project title and a project summary. Cards might contain images or graphics.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Cards will come in and out of view as we move up or down the page. Their functionality will be in the Card object.&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;Layout:&lt;/i&gt;&lt;/div&gt;&lt;div&gt;Cards should span the width unless on larger screens where they will have a set width.&amp;nbsp;&lt;/div&gt;" vertex="1">
          <mxGeometry height="275" width="465" x="35" y="1075" as="geometry" />
        </mxCell>
        <mxCell id="1dijiySgXApiauiCDTFy-32" parent="1dijiySgXApiauiCDTFy-5" style="text;html=1;whiteSpace=wrap;strokeColor=default;fillColor=default;align=left;verticalAlign=top;rounded=0;spacingLeft=6;dashed=1;container=0;" value="&lt;b&gt;&lt;u&gt;Section&lt;/u&gt;:&lt;/b&gt;&amp;nbsp; Introduction&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;The Introduction section will have an &#39;About&#39; statement describing the website. It might have an image and a paragraph informing the user what the site contains.&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="465" x="30" y="380" as="geometry" />
        </mxCell>
        <mxCell id="1dijiySgXApiauiCDTFy-33" parent="1dijiySgXApiauiCDTFy-5" style="text;html=1;whiteSpace=wrap;strokeColor=default;fillColor=default;align=left;verticalAlign=top;rounded=0;spacingLeft=6;dashed=1;container=0;" value="&lt;b&gt;&lt;u&gt;Header&lt;/u&gt;:&lt;/b&gt;&amp;nbsp; Navigation&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;The Navigation Header will contain the site / title, the current page title, &amp;amp; a dropdown menu for quick navigation.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;Value Changes&lt;/i&gt;:&lt;/div&gt;&lt;div&gt;Things that will change when we change directories.&amp;nbsp;&lt;/div&gt;&lt;div&gt;1. Page Title.&lt;/div&gt;&lt;div&gt;2. Site Icon -&amp;gt; might change to a back arrow and text.&lt;/div&gt;&lt;div&gt;3. Menu might change highlights.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;Input&lt;/i&gt;:&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Moving down the page will show the header disappearing, while moving up the page it will suddenly appear. This is for easier use on mobile applications.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="220" width="465" x="35" y="70" as="geometry" />
        </mxCell>
        <mxCell id="1dijiySgXApiauiCDTFy-34" parent="1dijiySgXApiauiCDTFy-5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#7F00FF,#B266FF);arcSize=12;fillStyle=auto;gradientColor=none;fontSize=36;container=0;" value="CARD" vertex="1">
