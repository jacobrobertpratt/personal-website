        <mxCell id="WlQTheIJuL9oZuFRspJ4-16" parent="1dijiySgXApiauiCDTFy-4" style="text;html=1;whiteSpace=wrap;strokeColor=light-dark(#000000,#00FF00);fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=24;dashed=1;strokeWidth=2;container=0;" value="This is an introduction paragraph. My name is Jake I do things and stuff. This site contains a collection of my projects in more detail than can be shown on github. It was also fun to build. Below you&#39;ll see a collection of projects.&amp;nbsp;" vertex="1">
