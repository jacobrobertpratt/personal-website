        <mxCell id="WlQTheIJuL9oZuFRspJ4-17" parent="1dijiySgXApiauiCDTFy-4" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;dashed=1;dashPattern=8 8;strokeWidth=2;strokeColor=light-dark(#000000,#FF00FF);fontStyle=4;container=0;" value="" vertex="1">
